# Optional. Enables the LLM root-cause panel (K8sGPTTerminalCard -> /api/explain).
# Without it the analyzer findings still render; the LLM section reports an error.
# The app calls GLM-4.5 through the z-ai-web-dev-sdk package.
# ZAI_API_KEY=...

# Overrides the Prometheus the dashboard queries (defaults to the k3d NodePort).
# PROMETHEUS_URL=http://localhost:30900

# Overrides the kubeconfig the API routes use (defaults to ~/.k3d/kubeconfig-gitops-demo.yaml).
# KUBECONFIG=/home/vscode/.k3d/kubeconfig-gitops-demo.yaml
