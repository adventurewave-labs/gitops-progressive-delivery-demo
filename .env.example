# Copy to `.env.local` and adjust as needed. All values are optional — the
# demo runs entirely client-side and needs no real cluster credentials.

# Next.js
NEXT_PUBLIC_APP_NAME="gitops-progressive-delivery-demo"

# Demo tunables (optional — overrides defaults in src/lib/demo-state.ts)
# NEXT_PUBLIC_DEMO_TICK_MS=1000
# NEXT_PUBLIC_DEMO_ANALYZING_MS=8000

# When wiring K8sGPT to a real cluster (out of scope for this demo),
# K8SGPT_BACKEND=openai
# K8SGPT_API_KEY=sk-...
