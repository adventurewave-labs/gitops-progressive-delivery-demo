{
  "name": "GitOps Progressive Delivery Demo",
  // Pinned: the floating `:ubuntu` tag now resolves to Ubuntu 'resolute',
  // where the docker-in-docker feature has no moby-cli packages.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1.32",
      "helm": "latest",
      "minikube": "none"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    3000,
    30800,
    30900,
    30910
  ],
  "portsAttributes": {
    "3000": { "label": "Next.js Dashboard" },
    "30800": { "label": "Argo CD UI" },
    "30900": { "label": "Prometheus" },
    "30910": { "label": "Rollouts Dashboard" }
  },
  "postCreateCommand": "cd ${containerWorkspaceFolder} && curl -fsSL https://bun.sh/install | bash && $HOME/.bun/bin/bun install",
  "remoteEnv": {
    "PATH": "/home/vscode/.bun/bin:${containerEnv:PATH}",
    "KUBECONFIG": "/home/vscode/.k3d/kubeconfig-gitops-demo.yaml"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-kubernetes-tools.vscode-kubernetes-tools"]
    }
  }
}
