{
  "name": "GitOps Progressive Delivery Demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "docker-in-docker": {
      "version": "26",
      "dockerDashComposeVersion": "v2.29.1"
    },
    "node": {
      "version": "20",
      "pnpm": false
    }
  },
  "forwardPorts": [
    3000,
    8080,
    9090,
    3100,
    30800,
    30900,
    30910
  ],
  "portsAttributes": {
    "3000": { "label": "Next.js Dashboard" },
    "8080": { "label": "Argo CD UI" },
    "9090": { "label": "Prometheus" },
    "30900": { "label": "Prometheus NodePort" },
    "30910": { "label": "Rollouts Dashboard" }
  },
  "postCreateCommand": "bash /workspace/gitops-progressive-delivery-demo/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-kubernetes-tools.vscode-kubernetes-tools"]
    }
  }
}