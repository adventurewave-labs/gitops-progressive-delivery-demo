{
  "name": "GitOps Progressive Delivery Demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [
    3000,
    30800,
    30900,
    30910
  ],
  "portsAttributes": {
    "3000": { "label": "Next.js Dashboard" },
    "30800": { "label": "Argo CD UI" },
    "30900": { "label": "Prometheus" },
    "30910": { "label": "Rollouts Dashboard" }
  },
  "postCreateCommand": "cd /workspace/gitops-progressive-delivery-demo && curl -fsSL https://bun.sh/install | bash && bun install",
  "customizations": {
    "vscode": {
      "extensions": ["ms-kubernetes-tools.vscode-kubernetes-tools"]
    }
  }
}